{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kenn2kenn22-bit/sign-language-content/main/schemas/content-approval.schema.json",
  "title": "SignLearn Content Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "status", "rights", "linguisticReview", "approvedAt"],
  "properties": {
    "assetId": {"type": "string"},
    "status": {"enum": ["candidate-vocabulary", "pending-signer", "needs-rights-review", "needs-linguistic-review", "approved-commercial", "approved-derived-only", "rejected"]},
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commercialUse", "imageConsent", "thirdPartyCleared", "derivativeScope"],
      "properties": {
        "commercialUse": {"type": "boolean"},
        "imageConsent": {"type": "boolean"},
        "thirdPartyCleared": {"type": "boolean"},
        "derivativeScope": {"enum": ["original-and-derived", "derived-only", "none"]},
        "evidenceRef": {"type": "string"}
      }
    },
    "linguisticReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewerRef"],
      "properties": {
        "status": {"enum": ["pending", "approved", "approved-with-notes", "needs-correction", "rejected"]},
        "reviewerRef": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "attribution": {"type": "string"},
    "approvedAt": {"type": ["string", "null"], "format": "date"},
    "approvedBy": {"type": ["string", "null"]}
  }
}
